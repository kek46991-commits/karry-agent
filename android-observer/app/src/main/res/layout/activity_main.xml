<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Karry Observer"
            android:textSize="26sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="iPhone操作エージェントの状態とエラーだけを表示します。Android端末のデータは読み取りません。"
            android:textSize="14sp" />

        <EditText
            android:id="@+id/serverUrl"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:autofillHints=""
            android:hint="@string/server_url"
            android:inputType="textUri"
            android:singleLine="true" />

        <EditText
            android:id="@+id/ownerToken"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:autofillHints="password"
            android:hint="@string/owner_token"
            android:inputType="textPassword"
            android:singleLine="true" />

        <EditText
            android:id="@+id/observerId"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:autofillHints=""
            android:hint="@string/observer_id"
            android:inputType="text"
            android:singleLine="true" />

        <EditText
            android:id="@+id/operationId"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:autofillHints=""
            android:hint="@string/operation_id"
            android:inputType="text"
            android:singleLine="true" />

        <Button
            android:id="@+id/enrollButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="@string/enroll" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button
                android:id="@+id/refreshButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/refresh" />

            <Button
                android:id="@+id/clearButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/clear_registration" />
        </LinearLayout>

        <TextView
            android:id="@+id/connectionStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="#172554"
            android:padding="12dp"
            android:text="未登録"
            android:textColor="#FFFFFF"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="iPhoneの操作履歴"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/actionList"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="#F1F5F9"
            android:minHeight="120dp"
            android:padding="12dp"
            android:text="まだ操作はありません"
            android:textColor="#0F172A"
            android:textIsSelectable="true" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="診断エージェント"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/diagnosticList"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="24dp"
            android:background="#FFF7ED"
            android:minHeight="120dp"
            android:padding="12dp"
            android:text="エラーはありません"
            android:textColor="#7C2D12"
            android:textIsSelectable="true" />
    </LinearLayout>
</ScrollView>
