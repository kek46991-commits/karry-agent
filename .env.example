GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-3.5-flash
SECRET_PASSPHRASE=
# 相対パスの基準。未設定時は CLI 実行ディレクトリ
KARRY_WORKSPACE=.
# 設定時は既存chat/run/session/run履歴APIにもBearer認証を要求する
KARRY_API_TOKEN=
# 既定0:既存コマンドallowlist。1:隔離された単一所有者環境でのみ任意shell
KARRY_ALLOW_SHELL=0
# Maps Routes API。OAuthではなく独立したAPIキーを使用
GOOGLE_MAPS_API_KEY=
# 共通OAuth JSON Secret。既存Calendar JSON Secretも引き続き利用可能
GOOGLE_WORKSPACE_TOKEN_JSON=
# Photos専用tokenを使う場合。Pickerスコープの承認が必要
GOOGLE_PHOTOS_TOKEN_JSON=
# JSON Secretの代わりにOAuth環境変数3点も利用可能
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
# Self-Healingの診断・既存再試行は常時接続。AI候補生成は明示的に有効化
KARRY_SELF_HEALING_GENERATE_PATCHES=0
# 候補は独立branch/draft PRだけに提出。mainの自動変更はしない
KARRY_SELF_HEALING_CREATE_PRS=0
KARRY_REPAIR_GITHUB_REPO=
KARRY_REPAIR_GITHUB_TOKEN=
KARRY_REPAIR_ARTIFACT_DIR=/tmp/karry-repairs
# 呼称は非公開の.envまたはRender Secretで設定。未設定時はPartner
PARTNER_NAME=
# PARTNER_NAMEが空の場合の互換名
CORE_USER_NAME=
# 認証済みprivate_modeだけに渡す任意コンテキスト。公開ファイルへ書かない
CORE_PRIVATE_CONTEXT=
# 一般自律ループ上限。URL短縮経路は既定で取得1回＋生成1回
KARRY_MAX_TOOL_STEPS=20
# Web成果物は既定s3（永続）。localは明示的な一時開発用のみ
KARRY_WEBSITE_STORAGE=s3
# R2非公開バケット、またはAWS S3バケット。通常の利用者は設定不要
KARRY_WEBSITE_S3_BUCKET=
KARRY_WEBSITE_S3_PREFIX=karry-websites/
# R2: https://<ACCOUNT_ID>.r2.cloudflarestorage.com / AWS S3:空欄でSDK既定
KARRY_WEBSITE_S3_ENDPOINT=
# R2:auto / AWS S3:対象リージョン
KARRY_WEBSITE_S3_REGION=auto
KARRY_WEBSITE_S3_ACCESS_KEY_ID=
KARRY_WEBSITE_S3_SECRET_ACCESS_KEY=
# AWS一時資格情報を利用する場合のみ
KARRY_WEBSITE_S3_SESSION_TOKEN=
# タスク履歴も同じ非公開S3/R2と上記鍵を共有。memoryは明示開発用のみ
KARRY_TASK_STORAGE=s3
# HTML prefixと重複しない専用領域。バケットの一般公開はしない
KARRY_TASK_S3_PREFIX=karry-tasks/
