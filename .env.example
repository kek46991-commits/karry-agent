GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-3.5-flash
SECRET_PASSPHRASE=
# 相対パスの基準。未設定時は CLI 実行ディレクトリ
KARRY_WORKSPACE=.
# 設定時は既存chat/run/session/run履歴APIにもBearer認証を要求する
KARRY_API_TOKEN=
# 既定0:既存コマンドallowlist。1:隔離された単一所有者環境でのみ任意shell
KARRY_ALLOW_SHELL=0
# Maps Routes API。OAuthではなく独立したAPIキーを使用
GOOGLE_MAPS_API_KEY=
# 共通OAuth JSON Secret。既存Calendar JSON Secretも引き続き利用可能
GOOGLE_WORKSPACE_TOKEN_JSON=
# Photos専用tokenを使う場合。Pickerスコープの承認が必要
GOOGLE_PHOTOS_TOKEN_JSON=
# JSON Secretの代わりにOAuth環境変数3点も利用可能
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
